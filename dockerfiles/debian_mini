FROM --platform=linux/386 docker.io/i386/debian:bookworm

ARG DEBIAN_FRONTEND=noninteractive

# Update, upgrade and install in one layer so the package index is fresh.
RUN apt-get clean && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 -y upgrade && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
      apt-utils gcc python3 vim unzip ruby nodejs \
      fakeroot dbus whiptail hexedit patch wamerican ucf manpages \
      file luajit make lua5.3 dialog curl less cowsay netcat-openbsd \
      lynis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify Lynis installation
RUN lynis --version

# Create user
RUN useradd -m user && echo "user:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="C.UTF-8"

RUN echo 'root:password' | chpasswd

CMD ["/bin/bash"]
