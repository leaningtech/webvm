FROM --platform=linux/386 docker.io/i386/debian:trixie

ARG DEBIAN_FRONTEND=noninteractive

# Fail immediately if any APT repository index cannot be downloaded.
# Acquire::Retries helps, but a warning from apt-get update must remain fatal.
RUN apt-get clean && \
    apt-get -o Acquire::Retries=10 update 2>&1 | tee /tmp/apt-update.log && \
    ! grep -Eq '^(E:|W: Failed to fetch)' /tmp/apt-update.log && \
    apt-get -o Acquire::Retries=10 -y upgrade && \
    apt-get -o Acquire::Retries=10 install -y --no-install-recommends \
      apt-utils gcc python3 vim unzip ruby nodejs \
      fakeroot dbus whiptail hexedit patch wamerican ucf manpages \
      file luajit make lua5.3 dialog curl less cowsay netcat-openbsd \
      lynis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-update.log

# Verify key tooling at image-build time.
RUN lynis --version && curl --version >/dev/null && less --version >/dev/null

# Create user
RUN useradd -m user && echo "user:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="C.UTF-8"

RUN echo 'root:password' | chpasswd

CMD ["/bin/bash"]
