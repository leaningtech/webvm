FROM --platform=linux/386 docker.io/i386/debian:buster

ARG DEBIAN_FRONTEND=noninteractive

# Debian Buster archived repositories
RUN echo "deb [trusted=yes] http://archive.debian.org/debian buster main contrib non-free" \
  > /etc/apt/sources.list && \
  echo "deb [trusted=yes] http://archive.debian.org/debian-security buster/updates main" \
  >> /etc/apt/sources.list

# Update, upgrade and install in ONE layer so the package index is never stale
RUN apt-get clean && \
    apt-get -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false update && \
    apt-get -o Acquire::Retries=5 -y upgrade && \
    apt-get -o Acquire::Retries=5 install -y \
      apt-utils gcc python3 vim unzip ruby nodejs \
      fakeroot dbus whiptail hexedit patch wamerican ucf manpages \
      file luajit make lua5.3 dialog curl less cowsay netcat-openbsd \
      lynis \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Verify Lynis installation
RUN lynis --version

# Create user
RUN useradd -m user && echo "user:password" | chpasswd

COPY --chown=user:user ./examples /home/user/examples
RUN chmod -R +x /home/user/examples/lua

WORKDIR /home/user/

ENV HOME="/home/user" \
    TERM="xterm" \
    USER="user" \
    SHELL="/bin/bash" \
    EDITOR="vim" \
    LANG="C.UTF-8"

RUN echo 'root:password' | chpasswd

CMD ["/bin/bash"]
